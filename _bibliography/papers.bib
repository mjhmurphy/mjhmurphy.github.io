@article{Murphy2025,
  title={Clicks or Comments? The quality-quantity trade-off of review systems},
  author={},
  year={2025},
  journal={},
  pdf={ClicksComments_mjHM.pdf},
  check={Working},
  selected = {true},
slides={ClicksCommentsSlides_mjHM.pdf},
  abstract = {I study the optimal design of review systems. A platform seeks to learn an unknown state from user-generated reviews. It faces a trade-off between the informativeness and frequency of these reviews.	Detailed reviews provide more information per review, but reviewers submit them less frequently than simple reviews. I characterize the informational content of review systems, which depends on the information in each review and the rate at which they are submitted. I use this characterization to derive the platform's optimal review system when reviewer's signals are imprecise. I apply these results to study how reviewers' taste heterogeneity affects the optimal binary review system. When reviewers are heterogeneous, the probability of extreme signals is large. When reviewers' tastes are sufficiently heterogeneous, the optimal binary review is symmetric: the platform  asks whether the reviewers' signal was “good" or “bad". When reviewers' preferences are sufficiently homogeneous, however, the optimal review is asymmetric: the platform asks whether or not the reviewers' signal was “horrible". Regardless of the level of heterogeneity, the optimal binary review is preferred to a fully detailed review system if it is submitted at least 3.25 times as frequently. }
}

